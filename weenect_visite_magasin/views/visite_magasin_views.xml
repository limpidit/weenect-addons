<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Vue formulaire ─────────────────────────────────────────────────── -->
    <record id="view_visite_magasin_form" model="ir.ui.view">
        <field name="name">weenect.visite.magasin.form</field>
        <field name="model">weenect.visite.magasin</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="magasin_id" placeholder="Magasin…"
                                   options="{'no_create': True}"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="magasin_id" invisible="True"/>
                            <field name="date_visite"/>
                            <field name="commercial_id"/>
                            <field name="emplacement"/>
                            <field name="nouveau_revendeur"/>
                        </group>
                        <group>
                            <field name="score_visite"/>
                            <field name="priorite_commerciale"
                                   decoration-danger="priorite_commerciale == 'urgent'"
                                   decoration-warning="priorite_commerciale == 'a_travailler'"
                                   decoration-success="priorite_commerciale == 'bon_niveau'"
                                   widget="badge"/>
                        </group>
                    </group>

                    <notebook>

                        <!-- ── Onglet Info générale ── -->
                        <page string="Info générale" name="info_generale">
                            <field name="personne_rencontree_ids"
                                   string="Personnes rencontrées"
                                   options="{'no_create_edit': True}">
                                <list>
                                    <field name="name"/>
                                </list>
                            </field>

                            <notebook>
                                <page string="Objectif de visite" name="objectif">
                                    <group>
                                        <field name="visite_suivi"/>
                                        <field name="visite_sav"/>
                                        <field name="visite_formation"/>
                                        <field name="visite_objectif_autre"
                                               placeholder="Préciser…"/>
                                    </group>
                                </page>
                                <page string="Concurrence" name="concurrence">
                                    <group string="Concurrence">
                                        <field name="concurrent_kippy"/>
                                        <field name="concurrent_tractive"/>
                                        <field name="concurrent_garmin"/>
                                        <field name="concurrent_dogtra"/>
                                        <field name="concurrent_invoxia"/>
                                        <field name="concurrent_airtag"/>
                                        <field name="concurrent_autre"
                                               placeholder="Autre concurrent…"/>
                                    </group>
                                </page>
                            </notebook>
                        </page>

                        <!-- ── Onglet Visibilité produit ── -->
                        <page string="Visibilité produit" name="visibilite">
                            <group>
                                <field name="produit_visible"/>
                                <field name="bon_emplacement"/>
                                <field name="plv_visible"/>
                                <field name="traceur_demo_actif"/>
                                <field name="double_implantation"/>
                                <field name="vendeur_deja_forme"/>
                                <field name="vendeur_forme_visite"/>
                                <field name="vendeur_implique"/>
                            </group>
                        </page>

                        <!-- ── Onglet PLV ── -->
                        <page string="PLV" name="plv">
                            <group string="Présentoir">
                                <field name="plv_presentoir_deja"/>
                                <field name="plv_presentoir_visite"/>
                                <field name="plv_presentoir_envoyer"/>
                            </group>
                            <group string="Affiche promo">
                                <field name="plv_affiche_deja"/>
                                <field name="plv_affiche_visite"/>
                                <field name="plv_affiche_envoyer"/>
                            </group>
                            <group string="Joue">
                                <field name="plv_jeu_deja"/>
                                <field name="plv_jeu_visite"/>
                                <field name="plv_jeu_envoyer"/>
                            </group>
                            <group string="Poster magasin">
                                <field name="plv_poster_deja"/>
                                <field name="plv_poster_visite"/>
                                <field name="plv_poster_envoyer"/>
                            </group>
                            <group string="Autres PLV">
                                <field name="plv_flyers"/>
                                <field name="plv_sticker_sol"/>
                                <field name="plv_autre" placeholder="Autre PLV…"/>
                            </group>
                        </page>

                        <!-- ── Onglet Photos ── -->
                        <page string="Photos" name="photos">
                            <group>
                                <group>
                                    <field name="photo_1" widget="image" string="Photo 1"
                                           options="{'size': [300, 300]}"/>
                                    <field name="photo_3" widget="image" string="Photo 3"
                                           options="{'size': [300, 300]}"/>
                                    <field name="photo_5" widget="image" string="Photo 5"
                                           options="{'size': [300, 300]}"/>
                                </group>
                                <group>
                                    <field name="photo_2" widget="image" string="Photo 2"
                                           options="{'size': [300, 300]}"/>
                                    <field name="photo_4" widget="image" string="Photo 4"
                                           options="{'size': [300, 300]}"/>
                                    <field name="photo_6" widget="image" string="Photo 6"
                                           options="{'size': [300, 300]}"/>
                                </group>
                            </group>
                        </page>

                        <!-- ── Onglet Suivi & Actions ── -->
                        <page string="Suivi &amp; Actions" name="suivi">
                            <group>
                                <field name="volume_magasin"/>
                                <field name="engagement_responsable"/>
                            </group>
                            <notebook>
                                <page string="Actions" name="actions">
                                    <group>
                                        <field name="action_calendrier_offres"/>
                                        <field name="action_videos_formation"/>
                                        <field name="action_formation_traceur"/>
                                        <field name="action_autre"
                                               placeholder="Autre action…"/>
                                    </group>
                                </page>
                            </notebook>
                            <separator string="CR de visite"/>
                            <field name="cr_de_visite" nolabel="1"
                                   placeholder="Compte-rendu de la visite…"/>
                        </page>

                        <!-- ── Onglet Ventes ── -->
                        <page string="Ventes" name="ventes">
                            <group>
                                <field name="expedition_a_prevoir"/>
                            </group>
                            <field name="ventes_realisees" nolabel="1"
                                   placeholder="Ex: 3 x Traceur GPS chat - à expédier 2 x Collier - laissé sur place"/>
                        </page>

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Vue liste ──────────────────────────────────────────────────────── -->
    <record id="view_visite_magasin_list" model="ir.ui.view">
        <field name="name">weenect.visite.magasin.list</field>
        <field name="model">weenect.visite.magasin</field>
        <field name="arch" type="xml">
            <list>
                <field name="date_visite" string="Date" optional="show"/>
                <field name="magasin_id" string="Description"/>
                <field name="commercial_id" optional="hide"/>
                <field name="score_visite" optional="hide"/>
                <field name="priorite_commerciale"
                       decoration-danger="priorite_commerciale == 'urgent'"
                       decoration-warning="priorite_commerciale == 'a_travailler'"
                       decoration-success="priorite_commerciale == 'bon_niveau'"
                       optional="hide"/>
                <field name="expedition_a_prevoir" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ── Recherche ──────────────────────────────────────────────────────── -->
    <record id="view_visite_magasin_search" model="ir.ui.view">
        <field name="name">weenect.visite.magasin.search</field>
        <field name="model">weenect.visite.magasin</field>
        <field name="arch" type="xml">
            <search>
                <field name="magasin_id"/>
                <field name="commercial_id"/>
                <filter name="urgent" string="Urgent"
                        domain="[('priorite_commerciale', '=', 'urgent')]"/>
                <filter name="a_travailler" string="À travailler"
                        domain="[('priorite_commerciale', '=', 'a_travailler')]"/>
                <filter name="bon_niveau" string="Bon niveau"
                        domain="[('priorite_commerciale', '=', 'bon_niveau')]"/>
                <filter name="expedition" string="Expédition à prévoir"
                        domain="[('expedition_a_prevoir', '=', True)]"/>
                <filter name="nouveaux" string="Nouveaux revendeurs"
                        domain="[('nouveau_revendeur', '=', True)]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_magasin" string="Magasin"
                            context="{'group_by': 'magasin_id'}"/>
                    <filter name="group_commercial" string="Commercial"
                            context="{'group_by': 'commercial_id'}"/>
                    <filter name="group_priorite" string="Priorité"
                            context="{'group_by': 'priorite_commerciale'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Action fenêtre ────────────────────────────────────────────────── -->
    <record id="action_visite_magasin" model="ir.actions.act_window">
        <field name="name">Visites Magasins</field>
        <field name="res_model">weenect.visite.magasin</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
