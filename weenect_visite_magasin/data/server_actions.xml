<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Action contextuelle "Visites du magasin" disponible dans le menu
            engrenage (Plus) de la fiche contact res.partner.
        -->
        <record id="action_server_visites_magasin_partner" model="ir.actions.server">
            <field name="name">Visites du magasin</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="binding_model_id" ref="base.model_res_partner"/>
            <field name="binding_type">action</field>
            <field name="state">code</field>
            <field name="code">
action = {
    "name": "Visites du magasin",
    "type": "ir.actions.act_window",
    "res_model": "weenect.visite.magasin",
    "view_mode": "list,form",
    "domain": [("magasin_id", "=", record.id)],
    "context": {"default_magasin_id": record.id},
}
            </field>
        </record>

    </data>
</odoo>
